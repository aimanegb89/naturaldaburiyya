{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://elsopdxvwyxvrbpdozng.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "natural-mcp",
      "version": "0.1.0",
      "title": "Natural — Healthy Drinks & Supplements"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's profile (full name, phone, username, avatar).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in user's orders, most recent first, with their line items.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max orders to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_order",
        "title": "Create order",
        "description": "Place an order for the signed-in user. Saves the order and its items to their account so it appears in their order history (list_my_orders) even after sign-out. The shop confirms and fulfills orders via WhatsApp. Provide either a saved address_id or a new delivery address (street + city).",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Product ID."
                  },
                  "product_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Product display name (English)."
                  },
                  "size": {
                    "type": "string",
                    "enum": [
                      "small",
                      "large"
                    ],
                    "description": "small = 350ml, large = 500ml."
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Unit price in ILS."
                  }
                },
                "required": [
                  "product_id",
                  "product_name",
                  "size",
                  "quantity",
                  "price"
                ]
              },
              "description": "Line items to order."
            },
            "address_id": {
              "description": "ID of a saved address belonging to the user. If omitted, street and city are required.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "street": {
              "description": "Street for a new delivery address.",
              "type": "string"
            },
            "city": {
              "description": "City for a new delivery address.",
              "type": "string"
            },
            "postal_code": {
              "description": "Postal code for a new delivery address.",
              "type": "string"
            },
            "phone": {
              "description": "Contact phone number.",
              "type": "string"
            },
            "notes": {
              "description": "Order notes for the shop.",
              "type": "string"
            }
          },
          "required": [
            "items"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_favorites",
        "title": "List my favorites",
        "description": "List the signed-in user's favorite product IDs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_favorite",
        "title": "Add favorite product",
        "description": "Add a product to the signed-in user's favorites.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "minLength": 1,
              "description": "Product ID to favorite."
            }
          },
          "required": [
            "product_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "remove_favorite",
        "title": "Remove favorite product",
        "description": "Remove a product from the signed-in user's favorites.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "minLength": 1,
              "description": "Product ID to unfavorite."
            }
          },
          "required": [
            "product_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
